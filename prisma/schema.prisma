// Prisma schema for DevPulse - Incident & Reliability Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  DOWN
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  SEV1_CRITICAL
  SEV2_MAJOR
  SEV3_MINOR
  SEV4_LOW
}

enum ChannelType {
  EMAIL
  WEBHOOK
  SLACK
}

enum WebhookStatus {
  PENDING
  PROCESSED
  REJECTED
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  memberships  Membership[]
  incidents    Incident[]    @relation("AssignedIncidents")
  timelineNotes IncidentTimelineEvent[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Organization {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  memberships Membership[]
  services    Service[]
  incidents   Incident[]
  channels    NotificationChannel[]
  webhooks    WebhookDelivery[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Service {
  id                      String        @id @default(uuid())
  organizationId          String        @map("organization_id")
  name                    String
  description             String?
  healthCheckUrl          String        @map("health_check_url")
  httpMethod              String        @default("GET") @map("http_method")
  checkIntervalSec        Int           @default(60) @map("check_interval_sec")
  timeoutMs               Int           @default(5000) @map("timeout_ms")
  expectedStatusCode      Int           @default(200) @map("expected_status_code")
  failureThreshold        Int           @default(3) @map("failure_threshold")
  consecutiveFailures     Int           @default(0) @map("consecutive_failures")
  status                  ServiceStatus @default(OPERATIONAL)
  isActive                Boolean       @default(true) @map("is_active")
  isPaused                Boolean       @default(false) @map("is_paused")
  lastCheckedAt           DateTime?     @map("last_checked_at")
  lastSuccessfulCheckAt   DateTime?     @map("last_successful_check_at")
  lastFailedCheckAt       DateTime?     @map("last_failed_check_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkResults            MonitoringCheckResult[]
  incidents               Incident[]

  @@index([organizationId])
  @@index([status])
  @@index([isActive, isPaused])
  @@map("services")
}

model MonitoringCheckResult {
  id             String        @id @default(uuid())
  serviceId      String        @map("service_id")
  organizationId String        @map("organization_id")
  statusCode     Int?          @map("status_code")
  responseTimeMs Int           @map("response_time_ms")
  isHealthy      Boolean       @map("is_healthy")
  errorMessage   String?       @map("error_message")
  timestamp      DateTime      @default(now())

  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
  @@index([organizationId, timestamp])
  @@map("monitoring_check_results")
}

model Incident {
  id                  String           @id @default(uuid())
  organizationId      String           @map("organization_id")
  serviceId           String           @map("service_id")
  title               String
  description         String
  severity            IncidentSeverity @default(SEV2_MAJOR)
  status              IncidentStatus   @default(INVESTIGATING)
  assignedToUserId    String?          @map("assigned_to_user_id")
  acknowledgedAt      DateTime?        @map("acknowledged_at")
  resolvedAt          DateTime?        @map("resolved_at")
  durationMinutes     Int?             @map("duration_minutes")
  isAutoCreated       Boolean          @default(true) @map("is_auto_created")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service             Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedToUser      User?            @relation("AssignedIncidents", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  timelineEvents      IncidentTimelineEvent[]
  notificationAttempts NotificationDeliveryAttempt[]

  @@index([organizationId, status])
  @@index([serviceId, status])
  @@index([createdAt])
  @@map("incidents")
}

model IncidentTimelineEvent {
  id          String        @id @default(uuid())
  incidentId  String        @map("incident_id")
  userId      String?       @map("user_id")
  eventType   String        @map("event_type") // STATUS_CHANGE, NOTE, ASSIGNMENT, DEPLOYMENT, ALERT
  message     String
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  incident    Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_timeline_events")
}

model NotificationChannel {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  type           ChannelType  @default(EMAIL)
  destination    String       // email address or webhook URL
  isEnabled      Boolean      @default(true) @map("is_enabled")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     NotificationDeliveryAttempt[]

  @@index([organizationId])
  @@map("notification_channels")
}

model NotificationDeliveryAttempt {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  incidentId     String       @map("incident_id")
  channelId      String       @map("channel_id")
  idempotencyKey String       @unique @map("idempotency_key")
  status         String       // PENDING, DELIVERED, FAILED
  attempts       Int          @default(1)
  payload        Json
  response       String?
  deliveredAt    DateTime?    @map("delivered_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel        NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([channelId])
  @@map("notification_delivery_attempts")
}

model WebhookDelivery {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  deliveryId      String        @unique @map("delivery_id") // GitHub X-GitHub-Delivery header
  event           String        // deployment, push, ping
  sender          String?
  status          WebhookStatus @default(PROCESSED)
  payload         Json
  responseMessage String?       @map("response_message")
  createdAt       DateTime      @default(now()) @map("created_at")

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  action         String       // SERVICE_CREATED, INCIDENT_RESOLVED, MEMBER_INVITED, etc.
  targetType     String       @map("target_type")
  targetId       String?      @map("target_id")
  details        Json?
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
